.env
output/
__pycache__/
*.pyc

# Rendered artefacts and run logs are reproducible from the project inputs.
projects/*/output/
projects/*/logs/
projects/*/thumbnail/

# Agent skills installed by `npx skills add` (vendored tooling, not project source).
.agents/

# Local virtualenv and derived knowledge-graph output. The bare pattern
# matches at any depth, so it covers both the code graph at the repo root
# and the knowledge graph at knowledge/graphify-out/. The knowledge vault
# itself (knowledge/**.md) is source and IS tracked.
.venv/
graphify-out/

# Symlinks created by the skills installer into the Claude Code skill dir.
.claude/skills/
# Machine-local editor/permission settings.
.claude/settings.local.json

# Composed audio tracks: deterministic output of `content-machine audio` from
# metadata.audio_plan (see tests/test_audio.py::test_same_plan_produces_identical_bytes).
# audio_manifest.json is kept - it carries the licence/provenance record, which
# is NOT reproducible by inspection.
projects/*/audio/track.wav

# Generation job state (runtime, not source)
jobs/

# Local AI/tool runtime state
.headroom/
.serena/
.claude/.headroom_wrap_settings.lock

# Generated project/runtime assets
projects/
output/
graphify-out/

# Local test/sync artifacts
SYNC_TEST.txt

# Archives/backups
*.tar
*.tar.gz
*.zip

# Python/runtime caches
__pycache__/
*.pyc
.venv/
venv/
