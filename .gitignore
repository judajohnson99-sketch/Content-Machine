# Secrets and local environment
.env
frontend/.env

# Language/runtime caches and dependencies
__pycache__/
*.pyc
.venv/
venv/
node_modules/

# Rendered artefacts, run logs and runtime state: reproducible from inputs.
output/
projects/*/output/
projects/*/logs/
projects/*/thumbnail/
# Composed audio is deterministic output of `content-machine audio`
# (tests/test_audio.py::test_same_plan_produces_identical_bytes). The
# audio_manifest.json beside it is kept: it carries the licence/provenance
# record, which is not reproducible by inspection.
projects/*/audio/track.wav
# Generated project assets at the repo root only. Unanchored, this name also
# hid webapp/apps/projects/, a real Django app.
/projects/
# Generation job state, worker registry and queue.
jobs/
# Local source references and rights records, shared across productions.
/library/
# Format-intelligence profiles and cached subject research: derived,
# regenerable from research.py / subject_research.py.
research/
*.log

# Derived knowledge-graph output at any depth: the code graph at the repo root
# and the knowledge graph at knowledge/graphify-out/. The vault itself
# (knowledge/**.md) is source and IS tracked.
graphify-out/

# Local AI/tool runtime state and machine-local settings.
.headroom/
.serena/
.claude/.headroom_wrap_*
.claude/settings.local.json
# Skills installed by `npx skills add` (vendored tooling, not project source).
.claude/skills/
.agents/
.playwright/
.playwright-mcp/
.stfolder/

# Web control center (webapp/ Django, frontend/ React+Vite) dev artefacts.
webapp/db.sqlite3
webapp/staticfiles/
frontend/dist/

# Archives, backups, local sync artefacts.
*.tar
*.tar.gz
*.zip
archive-*/
SYNC_TEST.txt
# Local browser-QA captures (Playwright screenshots)
qa/
