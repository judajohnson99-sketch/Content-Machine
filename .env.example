ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Which provider to use: "anthropic" (default) or "gemini"
LLM_PROVIDER=anthropic

# --- Image generation routing (scripts/generation.py) ---
# Order providers are tried. Default: comfyui,procedural,gemini,api
# The metered providers come last on purpose - one must never be reached by
# accident just because a free one was briefly unhealthy.
GENERATION_ORDER=comfyui,procedural,gemini,api

# Workstation ComfyUI. Unset means "PC is not available" - there is no
# localhost default, so a VPS run never probes itself.
COMFYUI_URL=
COMFYUI_MODEL=v1-5-pruned-emaonly.safetensors
# Defaults to config/comfyui_workflow.example.json
COMFYUI_WORKFLOW=

# Gemini image generation. The only route to DEPICTED imagery that needs no
# GPU, so this is what the VPS falls back to when the workstation is off.
#
# GEMINI_API_KEY above is for the creative brief. It does NOT enable image
# generation: this line does, and setting it is consenting to spend money.
# Leave it blank and the provider is skipped exactly like an absent one.
GEMINI_IMAGE_ENABLED=
# Optional. Defaults to GEMINI_API_KEY - set this to bill images separately.
GEMINI_IMAGE_API_KEY=
# Optional. Default: gemini-3.1-flash-image
GEMINI_IMAGE_MODEL=
# Optional. 1K (API default) / 2K / 4K, gemini-3 models only. 2K matches a
# 1080p render without upscaling; larger sizes cost more per image.
GEMINI_IMAGE_SIZE=

# External image API, for whichever other vendor is chosen later. Leave blank
# to keep it DISABLED. Setting these enables spending; nothing here is used
# until both are set.
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_API_MODEL=

# Routing behaviour (seconds / attempt count)
GENERATION_HEALTH_TIMEOUT=5
GENERATION_TIMEOUT=300
GENERATION_COOLDOWN=300
GENERATION_ATTEMPTS=2

# --- Remote GPU worker (scripts/worker.py) ---
# Two machines, two different halves of this file. The VPS needs the control
# plane block; the GPU machine needs the worker block. Neither needs both.

# ON THE VPS (control plane). Bind stays on loopback: the worker token travels
# in a header, so anything reachable from outside must have TLS in front of it
# (reverse proxy, or an SSH/WireGuard tunnel).
WORKER_API_BIND=127.0.0.1
WORKER_API_PORT=8788
# Lifecycle tuning. Defaults suit a slow card on a home connection.
WORKER_LEASE_SECONDS=900
WORKER_POLL_SECONDS=15
WORKER_ONLINE_SECONDS=90
WORKER_STALE_SECONDS=600
WORKER_MAX_ATTEMPTS=3
WORKER_MAX_ASSET_BYTES=33554432

# ON THE GPU MACHINE (worker). All three are required and none is defaulted.
# WORKER_TOKEN is printed once by `worker enroll` on the VPS and is never
# stored there in recoverable form - keep it only in this file, which is
# gitignored. COMFYUI_URL above is that machine's own ComfyUI.
CONTROL_PLANE_URL=
WORKER_TOKEN=

# --- Web control center (webapp/, frontend/) ---
# Local services on the same VPS as Django/Celery - not the "PC might be
# off" kind of endpoint COMFYUI_URL is; these are infra this deployment
# owns and starts itself, so a same-host default is correct and safe.
REDIS_URL=redis://127.0.0.1:6379/0

# Production only (webapp/cmweb/settings/prod.py). Unset means SQLite, the
# dev/test default - see settings/base.py for why that is fine for
# PipelineRun, the one table Phase 2 adds.
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# The Vite frontend's API base URL. Empty means same-origin (a reverse
# proxy serving both), which is the intended prod topology.
VITE_API_BASE_URL=
